PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/campusfix?schema=public
JWT_SECRET=campusfix_jwt_super_secret_key_2026_secure
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
